target := "rvsc0-unknown-elf"

import "../common.just"

default: test

# ISA compliance: compile → disassemble → check allowlist
test:
    PATH="{{prefix}}/bin:$PATH" python3 main.py

# Run a single source file through ISA compliance
test-one file:
    PATH="{{prefix}}/bin:$PATH" python3 main.py {{file}}

# Behavioral smoke tests: compile → Spike HTIF → check exit code
behav:
    PATH="{{prefix}}/bin:$PATH" python3 behav.py
