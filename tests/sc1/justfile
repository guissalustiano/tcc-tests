target := "rvsc1-unknown-elf"

import "../common.just"

default: test

# ISA compliance: compile → assemble → disassemble → check allowlist
test:
    PATH="{{prefix}}/bin:$PATH" python3 main.py

# Run a single source file through ISA compliance
test-one file:
    PATH="{{prefix}}/bin:$PATH" python3 main.py {{file}}

# ISA compliance over gcc.c-torture/execute (skips tests that fail to compile)
torture-isa:
    PATH="{{prefix}}/bin:$PATH" python3 torture_isa.py

# Behavioral: compile torture tests with sc1, run on Spike via pk (exit 0 = pass)
torture-behav:
    PATH="{{prefix}}/bin:$PATH" python3 torture_behav.py

# Behavioral differential: compile with sc1 + reference, run both on Spike, compare exit codes
behav:
    PATH="{{prefix}}/bin:$PATH" python3 behav.py

# Run a single behavioral test
behav-one file:
    PATH="{{prefix}}/bin:$PATH" python3 behav.py {{file}}
