target := "rvsc2-unknown-elf"

import "../common.just"

default: test

# Configure + build + install binutils then gcc (first-time setup)
setup: configure-binutils build-binutils install-binutils configure build install

# Run all sc2 ISA compliance tests
test:
    PATH="{{prefix}}/bin:$PATH" python3 main.py

# Run a single source file
test-one file:
    PATH="{{prefix}}/bin:$PATH" python3 main.py {{file}}
